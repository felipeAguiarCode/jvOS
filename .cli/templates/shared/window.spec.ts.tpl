import { expect, test, type Page } from "@playwright/test";
%%#data%%
import { next%%pascal%%Id, parse%%pascal%%, tidy%%pascal%%Text } from "../src/lib/%%kind%%";
%%/data%%
import { PLAIN_SETTINGS, waitForFrames } from "./helpers";

// The %%title%% %%groupLabel%% (.specs/%%specFolder%%/spec.md). Generated by `npm run new`: grow it with
// the spec's acceptance. It runs only once "%%kind%%" is in the `ui` project's testMatch.

const TITLE = "%%windowTitle%%";
const KEYS = ["jarvis.desktop", "jarvis.%%kind%%", "jarvis.widget.%%kind%%"];

async function start(page: Page) {
  await page.setViewportSize({ width: 1920, height: 1080 });
  await page.goto("/");
  await page.evaluate(
    ([settings, keys]) => {
      for (const key of keys) localStorage.removeItem(key);
      localStorage.setItem("jarvis.settings", settings);
    },
    [PLAIN_SETTINGS, KEYS] as const,
  );
  await page.reload();
  await waitForFrames(page, 10);
}

async function open(page: Page) {
  await page.evaluate(() => window.__JARVIS__!.voiceWindow({ kind: "%%kind%%" as never, open: true }));
  const pane = page.getByRole("dialog", { name: TITLE, exact: true });
  await expect(pane).toBeVisible();
  return pane;
}
%%#data%%

test("%%kind%% helpers: tolerant parsing, tidy text, the smallest free id", () => {
  expect(parse%%pascal%%("x")).toBeNull();
  expect(parse%%pascal%%([{ id: 1, text: "  um   item " }, { id: 1, text: "repetido" }, { id: "2", text: "id ruim" }, { id: 3, text: " " }, null])).toEqual([{ id: 1, text: "um item" }]);
  expect(tidy%%pascal%%Text("  a   b ")).toBe("a b");
  expect(next%%pascal%%Id([])).toBe(1);
  expect(next%%pascal%%Id([{ id: 1, text: "a" }, { id: 2, text: "b" }, { id: 4, text: "c" }])).toBe(3);
});
%%/data%%

test("%%windowTitle%%: opens by voice and shows its content", async ({ page }) => {
  await start(page);
  const pane = await open(page);
%%#app%%
  await expect(pane.getByTestId("%%kind%%-app")).toBeVisible();
%%/app%%
%%^app%%
  await expect(pane).toContainText("%%title%%");
%%/app%%
%%#data%%
  await expect(pane.getByText("Nada por aqui ainda.", { exact: false })).toBeVisible();

  await pane.getByLabel("Novo item").fill("Primeiro item");
  await pane.getByLabel("Novo item").press("Enter");
  await expect(pane.getByRole("list", { name: "%%title%%" }).getByRole("listitem")).toHaveCount(1);
  await expect.poll(() => page.evaluate(() => JSON.parse(localStorage.getItem("jarvis.%%kind%%") ?? "[]"))).toEqual([{ id: 1, text: "Primeiro item" }]);

  // Saved: still there after a reload (the window reopens by itself).
  await page.reload();
  await waitForFrames(page, 10);
  const reopened = page.getByRole("dialog", { name: TITLE, exact: true });
  await expect(reopened.getByRole("list", { name: "%%title%%" })).toContainText("Primeiro item");

  await reopened.getByRole("button", { name: "Apagar Primeiro item" }).click();
  await expect(reopened.getByText("Nada por aqui ainda.", { exact: false })).toBeVisible();
%%/data%%
});
%%#menu%%

test("%%title%%: right click turns the %%menuLabelLower%% off, and it stays so", async ({ page }) => {
  await start(page);
  const pane = await open(page);
  await pane.click({ button: "right" });
  const menu = page.getByRole("menu", { name: "Opções do widget %%title%%" });
  await expect(menu).toBeVisible();
  const option = menu.getByRole("menuitemcheckbox", { name: "%%menuLabel%%" });
  await expect(option).toHaveAttribute("aria-checked", "true");
  await option.click();
  await expect(option).toHaveAttribute("aria-checked", "false");
  await page.keyboard.press("Escape");
  await expect(menu).toBeHidden();
  await expect.poll(() => page.evaluate(() => JSON.parse(localStorage.getItem("jarvis.widget.%%kind%%") ?? "{}").details)).toBe(false);
});
%%/menu%%
